# ─── Supabase ────────────────────────────────────────────────────
# Get these from your Supabase project: Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Database (Prisma) ───────────────────────────────────────────
# Pooled connection (port 6543) — used at runtime
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Direct connection (port 5432) — used for migrations only
DIRECT_URL=postgresql://postgres.YOUR-PROJECT:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
